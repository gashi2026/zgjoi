# Local development only. Copy to .env and use a disposable development database.
# Keep production and preview credentials separate. Never commit real values.
DATABASE_URL="postgresql://zgjoi:replace-with-local-password@127.0.0.1:5432/zgjoi_dev"
DIRECT_URL="postgresql://zgjoi:replace-with-local-password@127.0.0.1:5432/zgjoi_dev"

# Generate locally: openssl rand -hex 32
# Keep the existing production key: replacing it makes existing encrypted data unreadable.
ENCRYPTION_KEY=""

# Optional local site lock. Production must stay closed while launch gates are open.
ZGJOI_PASSWORD=""
# Arrita helpline: admin WhatsApp number in international format, digits only (e.g. 383…). Unset = on-site alert only.
ZGJOI_HELPLINE_WHATSAPP=""
# Free address geocoding for Arrita (Nominatim). "off" disables it (address check then needs a photo).
GEOCODING_PROVIDER=""

# Generate locally: openssl rand -hex 32
CRON_SECRET=""

# Payment integration is incomplete. Only use test-mode credentials in isolated testing.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Canonical origin for this environment. Production must be https://zgjoi.com
# before email is turned on (links in messages use this value).
APP_URL="http://localhost:3000"
# Only "disabled" and "stripe_test" are supported. Live keys are rejected.
PAYMENTS_MODE="disabled"
# Transactional mail via Resend. Delivery stays off until every required value
# is set: EMAIL_DELIVERY_ENABLED=true, RESEND_API_KEY, EMAIL_FROM, and APP_URL.
# Unset or incomplete config is a no-op (jobs stay queued or are not created).
# DNS for zgjoi.com is at Cloudflare, not Vercel. Do not replace the apex MX
# (Google) or existing send.zgjoi.com / resend._domainkey records blindly.
EMAIL_DELIVERY_ENABLED="false"
# Outside production (VERCEL_ENV != "production") mail goes ONLY to these
# comma-separated addresses or domains, e.g. "owner@example.com,zgjoi.com".
# Empty = nothing is sent outside production; skipped sends are logged.
EMAIL_ALLOWLIST=""
RESEND_API_KEY=""
# Intended production sender (Reply-To is always info@zgjoi.com in code):
# EMAIL_FROM="Zgjoi <noreply@zgjoi.com>"
EMAIL_FROM=""
# Optional job notices (bookings, chat, etc.): also require each recipient to
# opt in under /siguria. ID approve/decline emails are transactional and do
# not need this flag.
JOB_EMAILS_ENABLED="false"
# Private documents: create zgjoi-pro-documents as a PRIVATE bucket first.
DOCUMENT_UPLOADS_ENABLED="false"
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
