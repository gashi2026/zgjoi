# Local development only. Copy to .env and use a disposable development database.
# Keep production and preview credentials separate. Never commit real values.
DATABASE_URL="postgresql://zgjoi:replace-with-local-password@127.0.0.1:5432/zgjoi_dev"
DIRECT_URL="postgresql://zgjoi:replace-with-local-password@127.0.0.1:5432/zgjoi_dev"

# Generate locally: openssl rand -hex 32
# Keep the existing production key: replacing it makes existing encrypted data unreadable.
ENCRYPTION_KEY=""

# Optional local site lock. Production must stay closed while launch gates are open.
ZGJOI_PASSWORD=""

# Generate locally: openssl rand -hex 32
CRON_SECRET=""

# Payment integration is incomplete. Only use test-mode credentials in isolated testing.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Canonical origin for this environment; Preview must point to the staging app.
APP_URL="http://localhost:3000"
# Only "disabled" and "stripe_test" are supported. Live keys are rejected.
PAYMENTS_MODE="disabled"
# Transactional account mail; all must be set before delivery is enabled.
EMAIL_DELIVERY_ENABLED="false"
RESEND_API_KEY=""
EMAIL_FROM=""
# Private documents: create zgjoi-pro-documents as a PRIVATE bucket first.
DOCUMENT_UPLOADS_ENABLED="false"
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
